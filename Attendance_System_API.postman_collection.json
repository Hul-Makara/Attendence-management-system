{
  "info": {
    "name": "Attendance System API v1.0",
    "_postman_id": "attendance-api-v1",
    "description": "Complete API collection matching the Attendance Student Management System documentation. Base URL: http://localhost:4000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "parentId", "value": "" },
    { "key": "classGroupId", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "attendanceId", "value": "" },
    { "key": "leaveId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (Admin — auto saves token)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.success && res.data) {",
                "  pm.collectionVariables.set('token', res.data.tokens);",
                "  if (res.data.user.studentId) pm.collectionVariables.set('studentId', res.data.user.studentId);",
                "  if (res.data.user.teacherId) pm.collectionVariables.set('teacherId', res.data.user.teacherId);",
                "  if (res.data.user.parentId) pm.collectionVariables.set('parentId', res.data.user.parentId);",
                "  pm.collectionVariables.set('userId', res.data.user.id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Login (Teacher)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
