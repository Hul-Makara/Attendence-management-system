    {
      "name": "8. Attendance",
      "description": "Mark, bulk mark, check-in, check-out, history, and CSV export",
      "item": [
        {
          "name": "Get Attendance Records (Filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('attendanceId', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["attendance"],
              "query": [
                { "key": "studentId", "value": "{{studentId}}", "disabled": true },
                { "key": "classId", "value": "{{classId}}", "disabled": true },
                { "key": "status", "value": "PRESENT", "disabled": true },
                { "key": "date", "value": "2026-11-11", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Mark Attendance (Single)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"date\": \"2026-11-11\",\n  \"status\": \"PRESENT\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"note\": \"Attentive in class\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/mark",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "mark"]
            }
          }
        },
        {
          "name": "Bulk Mark Attendance (Class)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-11\",\n  \"classId\": \"{{classId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"records\": [\n    {\n      \"studentId\": \"{{studentId}}\",\n      \"status\": \"PRESENT\",\n      \"note\": \"Present\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "bulk"]
            }
          }
        },
        {
          "name": "Student Check-In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"note\": \"Morning gate check-in\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/check-in",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "check-in"]
            }
          }
        },
        {
          "name": "Student Check-Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"subjectId\": \"{{subjectId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/check-out",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "check-out"]
            }
          }
        },
        {
          "name": "My Attendance History (Student)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/attendance/my-history",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "my-history"]
            }
          }
        },
        {
          "name": "Update Attendance Record",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"LATE\",\n  \"note\": \"Late due to traffic corrected by teacher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/{{attendanceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "{{attendanceId}}"]
            }
          }
        },
        {
          "name": "Export Attendance CSV",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/attendance/export/csv",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "export", "csv"]
            }
          }
        }
      ]
    },
    {
      "name": "9. Leave Requests",
      "description": "Submit, review, and view leave requests",
      "item": [
        {
          "name": "Submit Leave Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"fromDate\": \"2026-11-12\",\n  \"toDate\": \"2026-11-14\",\n  \"reason\": \"Family event\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leave-requests",
              "host": ["{{baseUrl}}"],
              "path": ["leave-requests"]
            }
          }
        },
        {
          "name": "Get All Leave Requests (Teacher/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('leaveId', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/leave-requests",
              "host": ["{{baseUrl}}"],
              "path": ["leave-requests"],
              "query": [
                { "key": "status", "value": "PENDING", "disabled": true },
                { "key": "studentId", "value": "{{studentId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get My Leave Requests (Student)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/leave-requests/my-requests",
              "host": ["{{baseUrl}}"],
              "path": ["leave-requests", "my-requests"]
            }
          }
        },
        {
          "name": "Review Leave Request (Approve/Reject)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewNote\": \"Approved by Class Teacher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leave-requests/{{leaveId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["leave-requests", "{{leaveId}}", "review"]
            }
          }
        }
      ]
    },
