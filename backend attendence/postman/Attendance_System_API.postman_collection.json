              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Login - Admin (Auto Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "    pm.environment.set('accessToken', res.data.accessToken);",
                  "    pm.environment.set('json_web_token_027g', res.data.accessToken);",
                  "    if (res.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "    }",
                  "    console.log('Access token saved to variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"Password123!\"\n}"
